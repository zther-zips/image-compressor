---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Simple Image Compressor">
  <main class="min-h-screen flex flex-col items-center relative">
    <!-- 中英切换按钮放在左上角 -->
    <button id="langToggle" class="absolute top-4 left-4 btn btn-sm btn-outline">
      中 / EN
    </button>

    <article
      class="container flex-1 h-full mx-auto max-w-screen-lg py-20 px-4 w-full overflow-auto flex flex-col items-center justify-center"
    >
      <header class="flex text-center flex-col items-center gap-5">
        <h1 id="mainTitle" class="text-5xl font-bold flex flex-col items-center gap-5">
          <span>🖼️</span> 图片压缩工具
        </h1>
        <p id="subtitle" class="text-pretty text-center mt-2">
          上传图片，设置目标文件大小，然后下载压缩后的版本。
        </p>
        <input
          type="file"
          id="imageInput"
          class="file-input mt-3 file-input-bordered"
          accept="image/*"
        />
      </header>
      <section id="settings" class="flex-col hidden mt-8 gap-4 items-center">
        <label id="sizeLabel" for="sizeInput">目标大小 (KB):</label>
        <input
          type="number"
          id="sizeInput"
          min="1"
          value="50"
          class="input input-bordered"
        />
        <button id="compressBtn" class="btn btn-primary">
          压缩图片
        </button>
      </section>

      <section
        id="preview"
        class="mt-16 hidden flex-col items-center justify-center"
      >
        <div
          class="flex md:flex-row flex-col-reverse gap-7 md:gap-5 items-center justify-center"
        >
          <div class="flex flex-col items-center">
            <h3 id="originalTitle">原图</h3>
            <p id="originalSize" class="font-medium"></p>

            <div class="divider"></div>
            <img
              id="originalPreview"
              class="aspect-square object-cover size-80"
              alt="Original Image"
            />
          </div>
          <div class="flex flex-col items-center">
            <h3 id="compressedTitle">压缩后</h3>
            <p id="compressedSize" class="font-medium"></p>
            <div class="divider"></div>

            <img
              id="compressedPreview"
              class="aspect-square object-cover size-80"
              alt="Compressed Image"
            />
          </div>
        </div>

        <button id="downloadBtn" class="btn btn-neutral mt-10 mx-auto" disabled>
          下载压缩后的图片
        </button>
      </section>
    </article>
    <div class="flex items-center py-4 gap-2">
      <p id="builtWith">使用</p>
      <a
        href="https://astro.build/"
        target="_blank"
        rel="noopener"
        class="flex items-center gap-2"
      >
        <Icon name="astro" size={25} color="black" />
        <span id="byText">部署  ---by </span>
        <a
          href="https://github.com/zther-zips"
          target="_blank"
          rel="noopener"
          class="link"
        >
          zther
        </a>

        <span id="findText">       ---源码见</span></a
      >
      <a
        href="https://github.com/zther-zips/image-compressor"
        target="_blank"
        rel="noopener"
      >
        <Icon name="github" size={25} color="black" />
      </a>
    </div>
  </main>
</Layout>

<script>
  import { compressImage, formatFileSize } from "../lib/utils";

  let compressedBlob: Blob | null = null;
  let currentLang = 'zh';

  // 国际化字典
  const i18n = {
    zh: {
      mainTitle: "<span>🖼️</span> 图片压缩工具",
      subtitle: "上传图片，设置目标文件大小，然后下载压缩后的版本。",
      sizeLabel: "目标大小 (KB):",
      compressBtn: "压缩图片",
      originalTitle: "原图",
      compressedTitle: "压缩后",
      downloadBtn: "下载压缩后的图片",
      sizePrefix: "大小: ",
      builtWith: "使用",
      byText: "由",
      findText: "– 源码见"
    },
    en: {
      mainTitle: "<span>🖼️</span> Image Compressor",
      subtitle: "Upload an image, set your target file size, and download the compressed version.",
      sizeLabel: "Target Size (KB):",
      compressBtn: "Compress Image",
      originalTitle: "Original",
      compressedTitle: "Compressed",
      downloadBtn: "Download Compressed Image",
      sizePrefix: "Size: ",
      builtWith: "Built with",
      byText: "by",
      findText: "– Find it on"
    }
  };

  const langToggle = document.getElementById("langToggle") as HTMLButtonElement;
  const mainTitle = document.getElementById("mainTitle") as HTMLHeadingElement;
  const subtitle = document.getElementById("subtitle") as HTMLParagraphElement;
  const sizeLabel = document.getElementById("sizeLabel") as HTMLLabelElement;
  const compressBtn = document.getElementById("compressBtn") as HTMLButtonElement;
  const originalTitle = document.getElementById("originalTitle") as HTMLHeadingElement;
  const compressedTitle = document.getElementById("compressedTitle") as HTMLHeadingElement;
  const downloadBtn = document.getElementById("downloadBtn") as HTMLButtonElement;
  const builtWith = document.getElementById("builtWith") as HTMLParagraphElement;
  const byText = document.getElementById("byText") as HTMLSpanElement;
  const findText = document.getElementById("findText") as HTMLSpanElement;

  const imageInput = document.getElementById("imageInput") as HTMLInputElement;
  const sizeInput = document.getElementById("sizeInput") as HTMLInputElement;
  const preview = document.getElementById("preview") as HTMLInputElement;
  const settings = document.getElementById("settings") as HTMLInputElement;

  const originalPreview = document.getElementById("originalPreview") as HTMLImageElement;
  const compressedPreview = document.getElementById("compressedPreview") as HTMLImageElement;
  const originalSize = document.getElementById("originalSize") as HTMLParagraphElement;
  const compressedSize = document.getElementById("compressedSize") as HTMLParagraphElement;

  // 切换语言逻辑
  function updateLanguage() {
    const t = i18n[currentLang as keyof typeof i18n];
    mainTitle.innerHTML = t.mainTitle;
    subtitle.textContent = t.subtitle;
    sizeLabel.textContent = t.sizeLabel;
    compressBtn.textContent = t.compressBtn;
    originalTitle.textContent = t.originalTitle;
    compressedTitle.textContent = t.compressedTitle;
    downloadBtn.textContent = t.downloadBtn;
    builtWith.textContent = t.builtWith;
    byText.textContent = t.byText;
    findText.textContent = t.findText;

    // 如果当前有图片，更新显示的尺寸前缀
    if (imageInput.files?.[0]) {
      originalSize.textContent = `${t.sizePrefix}${formatFileSize(imageInput.files[0].size)}`;
    }
    if (compressedBlob) {
      compressedSize.textContent = `${t.sizePrefix}${formatFileSize(compressedBlob.size)}`;
    }
  }

  langToggle.addEventListener("click", () => {
    currentLang = currentLang === 'zh' ? 'en' : 'zh';
    updateLanguage();
  });

  imageInput.addEventListener("change", async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    const t = i18n[currentLang as keyof typeof i18n];
    originalPreview.src = URL.createObjectURL(file);
    originalSize.textContent = `${t.sizePrefix}${formatFileSize(file.size)}`;

    const targetSize = parseInt(sizeInput.value);
    compressedBlob = await compressImage(file, targetSize);
    compressedPreview.src = URL.createObjectURL(compressedBlob);
    compressedSize.textContent = `${t.sizePrefix}${formatFileSize(compressedBlob.size)}`;

    downloadBtn.disabled = false;
    preview.style.display = "flex";
    settings.style.display = "flex";
  });

  compressBtn.addEventListener("click", async () => {
    if (!imageInput.files?.[0]) return;

    compressBtn.disabled = true;

    const t = i18n[currentLang as keyof typeof i18n];
    const targetSize = parseInt(sizeInput.value);
    compressedBlob = await compressImage(imageInput.files[0], targetSize);
    compressedPreview.src = URL.createObjectURL(compressedBlob);
    compressedSize.textContent = `${t.sizePrefix}${formatFileSize(compressedBlob.size)}`;

    compressBtn.disabled = false;
    downloadBtn.disabled = false;
  });

  downloadBtn.addEventListener("click", () => {
    if (!compressedBlob) return;

    const link = document.createElement("a");
    link.href = URL.createObjectURL(compressedBlob);
    link.download = "compressed-image.jpg";
    link.click();
  });
</script>
